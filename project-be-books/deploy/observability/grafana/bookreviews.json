      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(bookreviews_catalog_cache_lookups_total{result=\"hit\"}[$__rate_interval])) / sum(rate(bookreviews_catalog_cache_lookups_total[$__rate_interval]))",
          "instant": true
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Calls refused",
      "description": "Calls refused without reaching Gutendex: circuit open, or too many calls already in progress.",
